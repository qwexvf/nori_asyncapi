/// Resume support for SSE delivery. A browser `EventSource` echoes the
/// last event `id` it saw back as the `Last-Event-ID` header when it
/// reconnects; wire that header into `sse_backlog` so the server replays
/// only the events the client missed instead of the entire stream.
pub type SseResume {
  /// `replay_from(last_event_id)` returns the missed events oldest-first as
  /// `#(id, frame)` pairs, where `frame` is a `send_*` result. `last_event_id`
  /// is `None` on a fresh connect (no header) — usually return `[]` then.
  SseResume(replay_from: fn(Option(String)) -> List(#(String, String)))
}

/// Frame one live SSE event, stamping `id` as the resume cursor so the
/// browser echoes it back as `Last-Event-ID` on the next reconnect. `frame`
/// is the string a `send_*` encoder returned.
pub fn sse_event(id: String, frame: String) -> String {
  "id: " <> id <> "\ndata: " <> frame <> "\n\n"
}

/// Render the backlog a (re)connecting client missed into SSE wire text.
/// Pass the request's `Last-Event-ID` header (`None` when absent).
pub fn sse_backlog(resume: SseResume, last_event_id: Option(String)) -> String {
  resume.replay_from(last_event_id)
  |> list.map(fn(e) { sse_event(e.0, e.1) })
  |> string.join("")
}
